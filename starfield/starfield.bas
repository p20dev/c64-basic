10 PRINT CHR$(147):POKE 53280,0:POKE 53281,0
20 PRINT "            STARFIELD":PRINT:PRINT "1=SLOW  2=MEDIUM  3=FAST  Q=QUIT"
25 PRINT:PRINT "PRESS ANY KEY"
30 GET A$:IF A$="" THEN 30
35 R=RND(-TI)
40 DIM X(30),Y(30),Z(30):FOR I=1 TO 30:X(I)=INT(RND(1)*40)
45 Y(I)=INT(RND(1)*24):Z(I)=INT(RND(1)*3)+1:NEXT:V=2:PRINT CHR$(147)
50 FOR I=1 TO 30:P=1024+Y(I)*40+X(I):POKE P,32
60 X(I)=X(I)+Z(I)*V:IF X(I)>39 THEN X(I)=0:Y(I)=INT(RND(1)*24):Z(I)=INT(RND(1)*3)+1
70 P=1024+Y(I)*40+X(I):POKE P,46:POKE 55296+Y(I)*40+X(I),Z(I)+10
80 NEXT
90 GET A$:IF A$="1" THEN V=1
100 IF A$="2" THEN V=2
110 IF A$="3" THEN V=3
120 IF A$<>"Q" THEN 50
130 POKE 53280,14:POKE 53281,6:PRINT CHR$(147):END
