10 PRINT CHR$(147):PRINT "          LUNAR LANDER":PRINT
20 PRINT "EACH TURN CHOOSE BURN 0 TO 9.":PRINT "LAND AT SPEED 3 OR LESS.":PRINT:PRINT "PRESS ANY KEY"
30 GET A$:IF A$="" THEN 30
40 H=100:V=0:F=50:T=0
50 PRINT CHR$(147):PRINT "ALTITUDE";INT(H):PRINT "SPEED   ";INT(V*10)/10:PRINT "FUEL    ";F:PRINT
60 PRINT "BURN (0-9, OR -1 TO QUIT)";:INPUT B
70 IF B=-1 THEN 180
80 IF B<0 OR B>9 OR B>F THEN PRINT "INVALID BURN.":GOTO 60
90 F=F-B:V=V+2-B*.45:H=H-V:T=T+1
100 FOR I=1 TO 12:PRINT:PRINT TAB(19);"*":NEXT
110 IF H>0 THEN 50
120 PRINT CHR$(147):PRINT "TOUCHDOWN SPEED";INT(ABS(V)*10)/10:PRINT
130 IF ABS(V)<=3 THEN PRINT "PERFECT LANDING, COMMANDER!":GOTO 170
140 IF ABS(V)<=6 THEN PRINT "ROUGH LANDING. THE CREW IS SAFE.":GOTO 170
150 PRINT "CRASH! A NEW CRATER APPEARS."
170 PRINT:PRINT "R=REPLAY  Q=QUIT"
180 GET A$:IF A$="R" THEN RUN
190 IF A$<>"Q" THEN 180
200 PRINT CHR$(147):END

