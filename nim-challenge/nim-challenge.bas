10 PRINT CHR$(147):PRINT "          NIM CHALLENGE":PRINT
20 PRINT "THERE ARE 21 STICKS. TAKE 1, 2, OR 3."
30 PRINT "WHOEVER TAKES THE LAST STICK WINS.":PRINT
40 PRINT "PRESS ANY KEY"
50 GET A$:IF A$="" THEN 50
60 R=RND(-TI):N=21:PRINT CHR$(147)
70 PRINT "STICKS LEFT:";N:PRINT
80 FOR I=1 TO N:PRINT "|";:NEXT:PRINT:PRINT
90 INPUT "TAKE 1-3 (0 QUITS)";P
100 IF P=0 THEN 230
110 IF P<1 OR P>3 OR P>N THEN PRINT "CHOOSE 1, 2, OR 3.":GOTO 90
120 N=N-P:IF N=0 THEN PRINT "YOU TOOK THE LAST STICK!":GOTO 210
130 C=INT(RND(1)*3)+1:IF C>N THEN C=N
150 PRINT "THE COMPUTER TAKES";C:FOR D=1 TO 700:NEXT
160 N=N-C:IF N=0 THEN PRINT "THE COMPUTER WINS.":GOTO 210
170 PRINT CHR$(147):GOTO 70
210 PRINT:PRINT "R=PLAY AGAIN  Q=QUIT"
230 GET A$:IF A$="R" THEN RUN
240 IF A$<>"Q" THEN 230
250 PRINT CHR$(147):END
