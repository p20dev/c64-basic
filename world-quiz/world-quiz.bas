10 PRINT CHR$(147):PRINT "            WORLD QUIZ":PRINT
20 PRINT "ANSWER SEVEN QUESTIONS ABOUT OUR WORLD."
30 PRINT "PRESS 1, 2, OR 3. Q=QUIT.":PRINT
40 PRINT "PRESS ANY KEY"
50 GET A$:IF A$="" THEN 50
60 R=RND(-TI):DIM Q$(10),A$(10),B$(10),C$(10),K(10),U(10)
70 FOR I=1 TO 10:READ Q$(I),A$(I),B$(I),C$(I),K(I):NEXT:S=0
80 FOR T=1 TO 7
85 N=INT(RND(1)*10)+1:IF U(N) THEN 85
90 U(N)=1:PRINT CHR$(147):PRINT "QUESTION";T;"OF 7":PRINT
100 PRINT Q$(N):PRINT:PRINT "1. ";A$(N):PRINT "2. ";B$(N):PRINT "3. ";C$(N)
110 GET X$:IF X$="" THEN 110
120 IF X$="Q" THEN 230
130 IF VAL(X$)<1 OR VAL(X$)>3 THEN 110
140 IF VAL(X$)=K(N) THEN PRINT:PRINT "CORRECT!":S=S+1:GOTO 160
150 PRINT:PRINT "NOT THIS TIME. ANSWER";K(N)
160 FOR D=1 TO 700:NEXT:NEXT
170 PRINT CHR$(147):PRINT "FINAL SCORE";S;"OUT OF 7":PRINT
180 IF S=7 THEN PRINT "PERFECT WORLD TOUR!"
190 IF S>=4 AND S<7 THEN PRINT "SEASONED TRAVELLER!"
200 IF S<4 THEN PRINT "ANOTHER JOURNEY AWAITS."
210 PRINT:PRINT "R=PLAY AGAIN  Q=QUIT"
230 GET X$:IF X$="R" THEN RUN
240 IF X$<>"Q" THEN 230
250 PRINT CHR$(147):END
