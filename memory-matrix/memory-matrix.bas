10 PRINT CHR$(147):PRINT "         MEMORY MATRIX":PRINT
20 PRINT "WATCH THE NUMBERS, THEN REPEAT THEM.":PRINT "THE PATTERN GROWS EVERY ROUND."
25 PRINT:PRINT "PRESS ANY KEY"
30 GET A$:IF A$="" THEN 30
35 R=RND(-TI)
40 DIM S(30):L=1:FOR I=1 TO 30:S(I)=INT(RND(1)*4)+1:NEXT
50 PRINT CHR$(147):PRINT "ROUND";L:FOR I=1 TO L:GOSUB 130:NEXT
60 FOR D=1 TO 250:NEXT:PRINT CHR$(147)
70 FOR I=1 TO L:PRINT "STEP";I;" (1-4, Q QUITS)";
80 GET A$:IF A$="" THEN 80
90 IF A$="Q" THEN 180
100 IF VAL(A$)<>S(I) THEN PRINT:PRINT "WRONG! SCORE";L-1:GOTO 170
110 PRINT A$:NEXT:L=L+1:IF L<=30 THEN 50
120 PRINT "AMAZING! YOU COMPLETED ALL 30.":GOTO 170
130 PRINT CHR$(147):PRINT:PRINT:PRINT
140 IF S(I)=1 THEN PRINT "        1111":PRINT "        1111"
145 IF S(I)=2 THEN PRINT "                        2222":PRINT "                        2222"
150 IF S(I)=3 THEN PRINT:PRINT:PRINT "        3333":PRINT "        3333"
155 IF S(I)=4 THEN PRINT:PRINT:PRINT "                        4444":PRINT "                        4444"
160 FOR D=1 TO 220:NEXT:PRINT CHR$(147):FOR D=1 TO 60:NEXT:RETURN
170 PRINT:PRINT "R=REPLAY  Q=QUIT"
180 GET A$:IF A$="R" THEN RUN
190 IF A$<>"Q" THEN 180
200 PRINT CHR$(147):END

