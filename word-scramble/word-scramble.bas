10 PRINT CHR$(147):PRINT "         WORD SCRAMBLE":PRINT
20 PRINT "UNSCRAMBLE FIVE C64 WORDS.":PRINT "TYPE Q TO QUIT.":PRINT
30 PRINT "PRESS ANY KEY"
40 GET A$:IF A$="" THEN 40
50 R=RND(-TI):DIM W$(12),H$(12),U(12),P(20)
60 FOR I=1 TO 12:READ W$(I),H$(I):NEXT:S=0
70 FOR T=1 TO 5
80 N=INT(RND(1)*12)+1
85 IF U(N) THEN 80
90 U(N)=1:L=LEN(W$(N)):FOR I=1 TO L:P(I)=I:NEXT
100 FOR I=1 TO L:J=INT(RND(1)*L)+1:X=P(I):P(I)=P(J):P(J)=X:NEXT
110 A$="":FOR I=1 TO L:A$=A$+MID$(W$(N),P(I),1):NEXT
120 IF A$=W$(N) THEN 100
130 PRINT CHR$(147):PRINT "WORD";T;"OF 5":PRINT:PRINT "  ";A$:PRINT
140 PRINT "HINT: ";H$(N):PRINT:INPUT "YOUR ANSWER";G$
150 IF G$="Q" THEN 230
160 IF G$=W$(N) THEN PRINT "CORRECT!":S=S+1:GOTO 190
170 PRINT "THE WORD WAS ";W$(N)
190 FOR D=1 TO 700:NEXT:NEXT
200 PRINT CHR$(147):PRINT "FINAL SCORE";S;"OUT OF 5":PRINT
210 PRINT "R=PLAY AGAIN  Q=QUIT"
230 GET A$:IF A$="R" THEN RUN
240 IF A$<>"Q" THEN 230
250 PRINT CHR$(147):END
