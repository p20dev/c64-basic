10 PRINT CHR$(147):PRINT "          STOCK TRADER":PRINT
20 PRINT "MAKE THE MOST MONEY IN 20 DAYS.":PRINT "B=BUY S=SELL W=WAIT Q=QUIT"
25 PRINT:PRINT "PRESS ANY KEY"
30 GET A$:IF A$="" THEN 30
35 R=RND(-TI)
40 C=1000:N=0:P=50:FOR D=1 TO 20
50 P=P+INT(RND(1)*21)-10:IF P<5 THEN P=5
60 PRINT CHR$(147):PRINT "DAY";D;"OF 20":PRINT "PRICE $";P:PRINT "CASH  $";C
65 PRINT "SHARES ";N:PRINT "VALUE $";C+N*P
70 PRINT:PRINT "B, S, W, OR Q?"
80 GET A$:IF A$="" THEN 80
90 IF A$="Q" THEN 180
100 IF A$="W" THEN 150
110 IF A$="B" THEN PRINT "HOW MANY";:INPUT Q:IF Q>=0 AND Q*P<=C THEN C=C-Q*P:N=N+Q:GOTO 150
120 IF A$="S" THEN PRINT "HOW MANY";:INPUT Q:IF Q>=0 AND Q<=N THEN C=C+Q*P:N=N-Q:GOTO 150
130 PRINT "TRADE NOT POSSIBLE.":FOR T=1 TO 500:NEXT:GOTO 70
150 NEXT:C=C+N*P:N=0:PRINT CHR$(147):PRINT "MARKET CLOSED.":PRINT "FINAL WEALTH $";C
160 IF C>=1500 THEN PRINT "WALL STREET LEGEND!"
165 IF C>=1000 AND C<1500 THEN PRINT "A SOLID PROFIT."
170 IF C<1000 THEN PRINT "BETTER LUCK NEXT MARKET."
175 PRINT:PRINT "R=REPLAY  Q=QUIT"
180 GET A$:IF A$="R" THEN RUN
190 IF A$<>"Q" THEN 180
200 PRINT CHR$(147):END

